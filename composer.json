{
  "name": "mydashboard/shared-bundle",
  "description": "Shared backend building blocks for MyDashboard Symfony services",
  "type": "library",
  "license": "proprietary",
  "version": "1.0.0",
  "require": {
    "php": ">=8.3",
    "doctrine/orm": "^3.3",
    "lexik/jwt-authentication-bundle": "^3.1",
    "psr/log": "^3.0",
    "symfony/http-foundation": "^7.2",
    "symfony/http-kernel": "^7.2",
    "symfony/rate-limiter": "^7.2",
    "symfony/validator": "^7.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "MyDashboard\\Shared\\": "src/"
    }
  },
  "scripts": {
    "lint:phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist --warning-severity=0 src",
    "lint:phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "test": "vendor/bin/phpunit",
    "quality": [
      "@lint:phpcs",
      "@lint:phpstan"
    ]
  }
}
